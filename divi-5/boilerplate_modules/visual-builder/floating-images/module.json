{
    "name": "difl/floatimage",
    "d4Shortcode": "difl_floatimage",
    "title": "Floating Images",
    "titles": "Floating Imagess",
    "category": "module",
    "moduleIcon": "difl/float-image",
    "childModuleName": "difl/floatimageitem",
    "childrenName": [
        "difl/floatimageitem"
    ],
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "image": {
                "panel": "content",
                "groupName": "image",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image"
                    }
                }
            },
            "fi_settings": {
                "panel": "content",
                "groupName": "fi_settings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image Settings"
                    }
                }
            },
            "fi_animation": {
                "panel": "content",
                "groupName": "fi_animation",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Animation Settings"
                    }
                }
            },
            "contentLink": {
                "panel": "content",
                "groupName": "link",
                "priority": 100,
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link",
                        "preset": "content"
                    }
                }
            },
            "image_shadow": {
                "panel": "design",
                "groupName": "image_shadow",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image Shadow"
                    }
                }
            },
            "image_border": {
                "panel": "design",
                "groupName": "image_border",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image border"
                    }
                }
            }
        }
    },
    "customCssFields": {
        "title": {
            "label": "Label 1"
        },
        "content": {
            "label": "Label 2"
        }
    },
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink",
                            "component": {
                                "props": {
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                },
                "decoration": {
                    "background": {},
                    "border": {},
                    "boxShadow": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Floating Images"
                        }
                    }
                }
            }
        },
        "iamge": {
            "settings": {
                "decoration": {
                    "border": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "image_border",
                            "attrName": "iamge.decoration.border",
                            "label": "",
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/border",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": null
                                }
                            }
                        }
                    },
                    "boxShadow": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "image_shadow",
                            "attrName": "iamge.decoration.boxShadow",
                            "label": null,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/box-shadow",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                }
            },
            "styleProps": {
                "border": {
                    "selectors": {
                        "desktop": {
                            "value": "{{selector}} .df_fii_container img",
                            "hover": "{{selector}} .df_fii_container img:hover"
                        }
                    }
                },
                "boxShadow": {
                    "selectors": {
                        "desktop": {
                            "value": "{{selector}} .df_fii_container"
                        }
                    }
                }
            }
        },
        "fi_min_height": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "fi_settings",
                        "render": true,
                        "attrName": "fi_min_height.innerContent",
                        "label": "Container Min Height",
                        "features": {
                            "sticky": false,
                            "hover": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "defaultUnit": "px",
                                "min": "1",
                                "max": "2000",
                                "step": "1"
                            }
                        }
                    }
                }
            }
        }
    }
}