{
    "name": "difl/floatimageitem",
    "d4Shortcode": "difl_floatimageitem",
    "title": "Float Image Item",
    "titles": "Float Image Items",
    "category": "child-module",
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "image": {
                "panel": "content",
                "groupName": "image",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image"
                    }
                }
            },
            "fii_sizing": {
                "panel": "content",
                "groupName": "fii_sizing",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image Sizing"
                    }
                }
            },
            "fii_position": {
                "panel": "content",
                "groupName": "fii_position",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image Position"
                    }
                }
            },
            "fii_animation": {
                "panel": "content",
                "groupName": "fii_animation",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Animation Settings"
                    }
                }
            },
            "contentLink": {
                "panel": "content",
                "groupName": "link",
                "priority": 100,
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link",
                        "preset": "content"
                    }
                }
            },
            "image_shadow": {
                "panel": "design",
                "groupName": "image_shadow",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image Shadow"
                    }
                }
            },
            "image_filter": {
                "panel": "design",
                "groupName": "image_filter",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image Filter"
                    }
                }
            },
            "image_border": {
                "panel": "design",
                "groupName": "image_border",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image border"
                    }
                }
            }
        }
    },
    "customCssFields": {
        "title": {
            "label": "Label 1"
        },
        "content": {
            "label": "Label 2"
        }
    },
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink",
                            "component": {
                                "props": {
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                },
                "decoration": {
                    "background": {},
                    "border": {},
                    "boxShadow": {},
                    "filters": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Float Image Item"
                        }
                    }
                }
            }
        },
        "iamge": {
            "settings": {
                "decoration": {
                    "border": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "image_border",
                            "attrName": "iamge.decoration.border",
                            "label": "",
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/border",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": null
                                }
                            }
                        }
                    },
                    "boxShadow": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "image_shadow",
                            "attrName": "iamge.decoration.boxShadow",
                            "label": null,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/box-shadow",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                }
            },
            "styleProps": {
                "border": {
                    "selectors": {
                        "desktop": {
                            "value": ".difl_floatimage {{selector}} .df_fii_container img",
                            "hover": ".difl_floatimage {{selector}} .df_fii_container img:hover"
                        }
                    }
                },
                "boxShadow": {
                    "selectors": {
                        "desktop": {
                            "value": ".difl_floatimage {{selector}} .df_fii_container img"
                        }
                    }
                }
            }
        },
        "admin_label": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "admin_label",
                        "render": true,
                        "attrName": "admin_label.innerContent",
                        "label": "Admin Label",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/text"
                        }
                    }
                }
            }
        },
        "fii_max_width": {
            "type": "object",
