    "customCssFields": {
      "contentContainer": {
        "subName": "contentContainer",
        "selectorSuffix": " .difl_contentcarouselitem .df_cci_container"
      },
      "title": {
        "subName": "title",
        "selectorSuffix": " .difl_contentcarouselitem .df_cc_title"
