{
    "name": "diviflash/content-carousel-item",
    "d4Shortcode": "difl_contentcarouselitem",
    "title": "Advanced Carousel Item",
    "titles": "Advanced Carousel Item",
    "moduleClassName": "difl_contentcarouselitem",
    "moduleOrderClassName": "difl_contentcarouselitem",
    "category": "child-module",
    "attributes": {
      "module": {
        "type": "object",
        "selector": "{{selector}}",
        "styleProps": {
            "border": {
              "selector": "{{selector}} .difl_contentcarousel .difl_contentcarouselitem"
            },
            "boxShadow": {
              "selector": "{{selector}} .et_pb_toggle"
            },
            "spacing": {
              "propertySelectors": {
                "desktop": {
                  "value": {
                    "padding": "{{selector}} .difl_contentcarouselitem .df_cci_container"
                  }
                }
              },
              "important": {
                "desktop": {
                  "value": {
                    "margin": true
                  }
                }
              }
            }
        },
        "settings": {
          "meta": {
            "adminLabel": {}
          },
          "advanced": {
            "link": {
              "groupType": "group-item",
              "item": {
                "groupSlug": "contentLink",
                "priority": 20,
                "render": true,
                "component": {
                  "type": "group",
                  "name": "divi/link",
                  "props": {
                    "grouped": false
                  }
                }
              }
            },
            "text": {
              "priority": 15,
              "component": {
                "props": {
                  "fields": {
                    "color": {
                      "render": true
                    },
                    "orientation": {
                      "render": true
                    },
                    "textShadowGroup": {
                      "render": true
                    }
                  }
                }
              }
            },
            "htmlAttributes": {}
          },
          "decoration": {
            "animation": {},
            "background": {},
            "conditions": {},
            "disabledOn": {},
            "filters": {},
            "border": {},
            "boxShadow": {},
            "overflow": {},
            "position": {},
            "scroll": {},
            "sizing": {},
            "spacing": {},
            "sticky": {},
            "transform": {},
            "transition": {},
            "zIndex": {}
          }
        },
        "default": {
          "meta": {
            "adminLabel": {
              "desktop": {
                "value": "Advanced Carousel Item"
              }
            }
          }
        }
      },
      "title": {
        "type": "object",
        "selector": "{{selector}} .difl_contentcarouselitem .df_cc_title",
        "attributes": {
          "class": "difl_contentcarouselitem .df_cc_title"
        },
        "inlineEditor": "plainText",
        "childrenSanitizer": "et_core_esc_previously",
        "styleProps": {
          "font": {
            "important": {
              "font": {
                "desktop": {
                  "value": {
                    "color": true
                  }
                }
              }
            }
          }
        },
        "settings": {
          "innerContent": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "contentText",
              "attrName": "title.innerContent",
              "label": "Title",
              "description": "The title will appear above the content and when the toggle is closed.",
              "priority": 10,
              "render": true,
              "features": {
                "dynamicContent": {
                  "type": "text"
                },
                "sticky": false,
                "preset": "content"
              },
              "component": {
                "type": "field",
                "name": "divi/text"
              }
            }
          },
          "decoration": {
            "font": {
              "groupType": "group-item",
              "item": {
                "groupSlug": "designTitleText",
                "priority": 10,
                "render": true,
                "component": {
                  "type": "group",
                  "name": "divi/font",
                  "props": {
                    "grouped": false,
                    "groupLabel": "Title Text",
                    "fieldLabel": "Title",
                    "fields": {
                      "color": {
                        "priority": 5,
                        "render": true
                      },
                      "headingLevel": {
                        "render": true
                      }
                    }
                  }
                }
              }
            },
            "background": {
              "groupType": "group-item",
              "item": {
                "groupSlug": "designTitleText",
                "priority": 5,
                "render": true,
                "component": {
                  "type": "group",
                  "name": "divi/background",
                  "props": {
                    "grouped": false,
                    "attrName": "title.decoration"
                  }
                }
              }
            }
          }
        },
        "tagName": "h4",
        "elementType": "heading"
      },
      "subTitle": {
        "type": "object",
        "selector": "{{selector}} .df_cci_container .df_cc_subtitle",
        "attributes": {
          "class": ".df_cci_container .df_cc_subtitle"
        },
