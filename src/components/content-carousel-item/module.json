        },
        "settings": {
          "innerContent": {
            "groupType": "group-items",
            "items": {
              "text": {
                "groupSlug": "btnLink",
                "attrName": "button.innerContent",
                "subName": "text",
                "label": "Button Text",
                "description": "Define the text for the slide button",
                "priority": 10,
                "render": true,
                "features": {
                  "dynamicContent": {
                    "type": "text"
