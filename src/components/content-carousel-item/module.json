              }
            }
          }
        },
        "settings": {
          "decoration": {
            "icon": {
              "groupType": "group-items",
              "items": {
                "icon": {
                  "groupSlug": "contentImageIcon",
                  "attrName": "useIcon.decoration.icon",
                  "label": "Icon",
                  "priority": 10,
                  "render": true,
                  "features": {
                    "preset": [
                      "style",
                      "html"
                    ]
                  },
                  "component": {
                    "type": "field",
                    "name": "divi/icon-picker"
                  }
                },
                "iconAttributes": {
                  "groupSlug": "contentImageIcon",
                  "attrName": "useIcon.decoration.icon",
                  "priority": 10,
                  "render": true,
                  "component": {
                    "type": "group",
                    "name": "divi/icon",
                    "props": {
                      "grouped": false,
                      "fieldLabel": "Icon",
                      "fields": {
                        "icon": {
                          "render": false
                        },
                        "color": {
                          "render": true
                        },
                        "useSize": {
                          "render": true
                        },
                        "size": {
                          "render": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },

      "button": {
        "type": "object",
        "selector": " {{selector}} .df_cci_button_wrapper .df_cci_button",
        "attributes": {
          "class": "df_cci_button"
        },
        "elementType": "button",
        "elementProps": {
          "allowEmptyUrl": true,
          "hasWrapper": true
