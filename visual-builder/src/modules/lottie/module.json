{
    "name": "difl/lottieimage",
    "d4Shortcode": "difl_lottieimage",
    "title": "Lottie",
    "titles": "Lotties",
    "category": "module",
    "moduleIcon": "difl/lottie-image",
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "source": {
                "panel": "content",
                "groupName": "source",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Lottie Source"
                    }
                }
            },
            "settings": {
                "panel": "content",
                "groupName": "settings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Lottie Settings"
                    }
                }
            },
            "contentLink": {
                "panel": "content",
                "groupName": "link",
                "priority": 100,
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link",
                        "preset": "content"
                    }
                }
            },
            "image": {
                "panel": "design",
                "groupName": "image",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image Styles"
                    }
                }
            }
        }
    },
    "customCssFields": {},
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink",
                            "component": {
                                "props": {
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                },
                "decoration": {
                    "background": {},
                    "boxShadow": {},
                    "filters": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Lottie"
                        }
                    }
                }
            }
        },
        "lottie_file_options": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "source",
                        "render": true,
                        "attrName": "lottie_file_options.innerContent",
                        "label": "Lottion File Location",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/select",
                            "props": {
                                "options": {
                                    "external": {
                                        "label": "External File URL"
                                    },
                                    "media": {
                                        "label": "From Media"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "external_file": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "source",
                        "render": true,
                        "attrName": "external_file.innerContent",
                        "label": "URL",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/text"
                        }
                    }
                }
            },
            "show_if_not": {
                "lottie_file_options": "media"
            }
        },
        "upload": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "source",
                        "render": true,
                        "attrName": "upload.innerContent",
                        "label": "Upload",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/upload"
                        }
                    }
                }
            },
            "show_if": {
                "lottie_file_options": "media"
            }
        },
        "json_ex_notice": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/df_json_ex_notice"
                        }
                    }
                }
            }
        },
        "animation_trigger": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "settings",
                        "render": true,
                        "attrName": "animation_trigger.innerContent",
                        "label": "Animation trigger",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/select",
                            "props": {
                                "options": {
                                    "viewport": {
                                        "label": "Viewport"
                                    },
                                    "on_click": {
                                        "label": "On Click"
                                    },
                                    "on_hover": {
                                        "label": "On Hover"
                                    },
                                    "on_scroll": {
                                        "label": "On Scroll"
                                    },
                                    "none": {
                                        "label": "None"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "scroll_effect": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "settings",
                        "render": true,
                        "attrName": "scroll_effect.innerContent",
                        "label": "Track Divi Scroll Effect",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/toggle"
                        }
                    }
                }
            },
            "show_if": {
                "animation_trigger": "on_scroll"
            }
        },
        "stop_on_mouse_out": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "settings",
                        "render": true,
                        "attrName": "stop_on_mouse_out.innerContent",
                        "label": "Pause Animation Mouse Leave",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/toggle"
                        }
                    }
                }
            },
            "show_if": {
                "animation_trigger": "on_hover"
            }
        },
        "threshold": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "settings",
                        "render": true,
                        "attrName": "threshold.innerContent",
                        "label": "Threshold",
                        "description": "It has a default value of zero, which means that as soon as a user approaches the target element and it becomes visible",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "allowedUnits": [
                                    ""
                                ],
                                "defaultUnit": "",
                                "min": "0",
                                "max": "1",
                                "step": ".1"
                            }
                        }
                    }
                }
            },
            "show_if": {
                "animation_trigger": "viewport"
            }
        },
        "loop": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "settings",
                        "render": true,
                        "attrName": "loop.innerContent",
                        "label": "Loop",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/toggle"
                        }
                    }
                }
            }
        },
        "speed": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "settings",
                        "render": true,
                        "attrName": "speed.innerContent",
                        "label": "Animation Speed",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "allowedUnits": [
                                    ""
                                ],
                                "defaultUnit": "",
                                "min": "1",
                                "max": "15",
                                "step": ".5"
                            }
                        }
                    }
                }
            }
        },
        "direction_reverse": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "settings",
                        "render": true,
                        "attrName": "direction_reverse.innerContent",
                        "label": "Reverse Direction",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/toggle"
                        }
                    }
                }
            }
        },
        "renderer": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "settings",
                        "render": true,
                        "attrName": "renderer.innerContent",
                        "label": "Renderer",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/select",
                            "props": {
                                "options": {
                                    "svg": {
                                        "label": "SVG"
                                    },
                                    "canvas": {
                                        "label": "Canvas"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}