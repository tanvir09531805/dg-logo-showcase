{
    "name": "difl/logocarouselitem",
    "d4Shortcode": "difl_logocarouselitem",
    "title": "Logo Carousel Item",
    "titles": "Logo Carousel Items",
    "category": "child-module",
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "image": {
                "panel": "content",
                "groupName": "image",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image"
                    }
                }
            },
            "contentLink": {
                "panel": "content",
                "groupName": "link",
                "priority": 100,
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link",
                        "preset": "content"
                    }
                }
            }
        }
    },
    "customCssFields": {
        "title": {
            "label": "Label 1"
        },
        "content": {
            "label": "Label 2"
        }
    },
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink",
                            "component": {
                                "props": {
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                },
                "decoration": {
                    "background": {},
                    "boxShadow": {},
                    "filters": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Logo Carousel Item"
                        }
                    }
                }
            }
        },
        "admin_label": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "admin_label",
                        "render": true,
                        "attrName": "admin_label.innerContent",
                        "label": "Admin Label",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/text"
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "image",
                        "render": true,
                        "attrName": "image.innerContent",
                        "label": "Image",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/upload"
                        }
                    }
                }
            }
        },
        "alt_text": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "image",
                        "render": true,
                        "attrName": "alt_text.innerContent",
                        "label": "Image Alt Text",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/text"
                        }
                    }
                }
            }
        }
    }
}