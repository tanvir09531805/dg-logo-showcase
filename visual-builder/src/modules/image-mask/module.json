{
    "name": "difl/imagemask",
    "d4Shortcode": "difl_imagemask",
    "title": "Image Mask",
    "titles": "Image Masks",
    "category": "module",
    "moduleIcon": "difl/image-masking",
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "image": {
                "panel": "content",
                "groupName": "image",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Image"
                    }
                }
            },
            "mask_settings": {
                "panel": "content",
                "groupName": "mask_settings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Mask Settings"
                    }
                }
            },
            "contentLink": {
                "panel": "content",
                "groupName": "link",
                "priority": 100,
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link",
                        "preset": "content"
                    }
                }
            }
        }
    },
    "customCssFields": {},
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink",
                            "component": {
                                "props": {
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                },
                "decoration": {
                    "background": {},
                    "boxShadow": {},
                    "filters": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Image Mask"
                        }
                    }
                }
            }
        },
        "image": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "image",
                        "render": true,
                        "attrName": "image.innerContent",
                        "label": "Image",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/upload"
                        }
                    }
                }
            }
        },
        "alt_text": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "image",
                        "render": true,
                        "attrName": "alt_text.innerContent",
                        "label": "Image Alt Text",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/text"
                        }
                    }
                }
            }
        },
        "mask_size": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "mask_settings",
                        "render": true,
                        "attrName": "mask_size.innerContent",
                        "label": "Mask Size",
                        "features": {
                            "sticky": false,
                            "hover": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "allowedUnits": [
                                    "%"
                                ],
                                "defaultUnit": "%",
                                "min": "1",
                                "max": "100",
                                "step": "1"
                            }
                        }
                    }
                }
            }
        },
