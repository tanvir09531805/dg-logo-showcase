{
    "name": "difl/text-reveal",
    "d4Shortcode": "difl_text_reveal",
    "title": "Scroll Text Reveal",
    "titles": "Scroll Text Reveals",
    "category": "module",
    "moduleIcon": "difl/scroll-text-reveal",
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "toggle_key__content": {
                "panel": "content",
                "groupName": "toggle_key__content",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Text"
                    }
                }
            },
            "toggle_key__reveal_settings": {
                "panel": "content",
                "groupName": "toggle_key__reveal_settings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Reveal Settings"
                    }
                }
            },
            "contentLink": {
                "panel": "content",
                "groupName": "link",
                "priority": 100,
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link",
                        "preset": "content"
                    }
                }
            },
            "text": {
                "panel": "design",
                "groupName": "text",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Text"
                    }
                }
            },
            "header": {
                "panel": "design",
                "groupName": "header",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Heading Text"
                    }
                }
            },
            "width": {
                "panel": "design",
                "groupName": "width",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Sizing"
                    }
                }
            }
        }
    },
    "customCssFields": {},
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink",
                            "component": {
                                "props": {
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                },
                "decoration": {
                    "background": {
                        "component": {
                            "type": "group",
                            "name": "divi/background",
                            "props": {
                                "hidePanels": [
                                    "video",
                                    "pattern",
                                    "mask"
                                ]
                            }
                        }
                    },
                    "border": {},
                    "boxShadow": {},
                    "spacing": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Scroll Text Reveal"
                        }
                    }
                }
            },
            "styleProps": {
                "boxShadow": {
                    "selectors": {
                        "desktop": {
                            "value": "{{selector}}"
                        }
                    }
                },
                "spacing": {
                    "selectors": {
                        "desktop": {
                            "value": "{{selector}}"
                        }
                    }
                }
            }
        },
        "text-body": {
            "settings": {
                "decoration": {
                    "font": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "text",
                            "attrName": "text-body.decoration.font",
                            "label": "Text",
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/font-body",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": "Text",
                                    "fields": {
                                        "headingLevel": {
                                            "render": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "header": {
            "settings": {
                "decoration": {
                    "font": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "header",
                            "attrName": "header.decoration.font",
                            "label": "Heading",
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/font-header",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": "Heading",
                                    "fields": {
                                        "headingLevel": {
                                            "render": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "styleProps": {
                "font": {
                    "selectors": {
                        "desktop": {
                            "value": "{{selector}} .df_text_reveal_main_container h1"
                        }
                    }
                }
            }
        },
        "settings__content": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__content",
                        "render": true,
                        "attrName": "settings__content.innerContent",
                        "label": "Text",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/richtext"
                        }
                    }
                }
            }
        },
        "settings__trigger_type": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__trigger_type.innerContent",
                        "label": "Trigger Type",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/select",
                            "props": {
                                "options": {
                                    "auto": {
                                        "label": "Auto"
                                    },
                                    "with-scroll": {
                                        "label": "With Scroll"
                                    },
                                    "on-viewport": {
                                        "label": "On Viewport"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "settings__split_content": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__split_content.innerContent",
                        "label": "Split Content",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/select",
                            "props": {
                                "options": {
                                    "df_text_reveal_letter_by_letter": {
                                        "label": "Letter By Letter"
                                    },
                                    "df_text_reveal_word_by_word": {
                                        "label": "Word By Word"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "settings__reveal_by": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__reveal_by.innerContent",
                        "label": "Reveal By",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/select",
                            "props": {
                                "options": {
                                    "df_text_reveal_by_opacity_animationr": {
                                        "label": "Opacity Animation"
                                    },
                                    "df_text_reveal_by__dual_color_animation": {
                                        "label": "Dual Color"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "settings__reveal_color": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__reveal_color.innerContent",
                        "label": "Reveal color",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/color-picker"
                        }
                    }
                }
            },
            "show_if": {
                "settings__reveal_by": "df_text_reveal_by__dual_color_animation"
            }
        },
        "settings__reveal_duration": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__reveal_duration.innerContent",
                        "label": "Animation Duration (ms)",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "min": 0,
                                "max": 10000,
                                "step": 1
                            }
                        }
                    }
                }
            },
            "show_if": {
                "settings__trigger_type": [
                    "auto",
                    "on-viewport"
                ]
            }
        },
        "settings__reveal_delay": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__reveal_delay.innerContent",
                        "label": "Animation Delay (ms)",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "min": 0,
                                "max": 10000,
                                "step": 1
                            }
                        }
                    }
                }
            },
            "show_if": {
                "settings__trigger_type": [
                    "auto",
                    "on-viewport"
                ]
            }
        },
        "settings__reveal_initial_opacity": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__reveal_initial_opacity.innerContent",
                        "label": "Initial Opacity",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "min": 0.10000000000000001,
                                "max": 0.90000000000000002,
                                "minLimit": 0.10000000000000001,
                                "maxLimit": 0.90000000000000002,
                                "step": 0.01
                            }
                        }
                    }
                }
            }
        },
        "settings__reveal_viewport_offset_value_top": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__reveal_viewport_offset_value_top.innerContent",
                        "label": "Viewport offset top",
                        "description": "Unit in percentage,value calculate from viewport bottom ",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "allowedUnits": [
                                    "%",
                                    "px"
                                ],
                                "defaultUnit": "%",
                                "min": "0",
                                "max": "100",
                                "step": "1"
                            }
                        }
                    }
                }
            },
            "show_if": {
                "settings__trigger_type": [
                    "on-viewport",
                    "with-scroll"
                ]
            }
        },
        "settings__reveal_viewport_offset_value_bottom": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "toggle_key__reveal_settings",
                        "render": true,
                        "attrName": "settings__reveal_viewport_offset_value_bottom.innerContent",
                        "label": "Viewport offset Bottom",
                        "description": "Unit in percentage,value calculate from viewport bottom ",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/range",
                            "props": {
                                "allowedUnits": [
                                    "%",
                                    "px"
                                ],
                                "defaultUnit": "%",
                                "min": "0",
                                "max": "100",
                                "step": "1"
                            }
                        }
                    }
                }
            },
            "show_if": {
                "settings__trigger_type": [
                    "on-viewport",
                    "with-scroll"
                ]
            }
        }
    }
}