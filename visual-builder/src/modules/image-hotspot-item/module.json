                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/toggle"
                        }
                    }
                }
            },
            "show_if": {
                "spot_type": "icon"
            }
        },
        "image_as_icon": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "spot",
                        "render": true,
                        "attrName": "image_as_icon.innerContent",
                        "label": "Image",
                        "features": {
                            "sticky": false,
