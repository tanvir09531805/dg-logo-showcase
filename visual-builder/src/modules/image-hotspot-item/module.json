{
    "name": "difl/imagehotspotitem",
    "d4Shortcode": "difl_imagehotspotitem",
    "title": "Image Hotspot Item",
    "titles": "Image Hotspot Items",
    "category": "child-module",
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "spot": {
                "panel": "content",
                "groupName": "spot",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Spot Content"
                    }
                }
            },
            "spot_settings": {
                "panel": "content",
                "groupName": "spot_settings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Spot Settings"
                    }
                }
            },
            "tooltip_content": {
                "panel": "design",
                "groupName": "tooltip_content",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Tooltip"
                    }
                }
            },
            "tooltip_settings": {
                "panel": "content",
                "groupName": "tooltip_settings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Tooltip Settings"
                    }
                }
            },
            "spot_background": {
                "panel": "content",
                "groupName": "spot_background",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Spot Background"
                    }
                }
            },
            "contentLink": {
                "panel": "content",
                "groupName": "link",
                "priority": 100,
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link",
                        "preset": "content"
                    }
                }
            },
            "spot_item_design": {
                "panel": "design",
                "groupName": "spot_item_design",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Spot Text"
                    }
                }
            },
            "spot_icon_image": {
                "panel": "design",
                "groupName": "spot_icon_image",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Spot Icon/Image"
                    }
                }
            },
            "custom_spacing": {
                "panel": "design",
                "groupName": "custom_spacing",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Custom Spacing"
                    }
                }
            }
        }
    },
    "customCssFields": {
        "title": {
            "label": "Label 1"
        },
        "content": {
            "label": "Label 2"
        }
    },
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink",
                            "component": {
                                "props": {
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                },
                "decoration": {
                    "border": {},
                    "boxShadow": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Image Hotspot Item"
                        }
                    }
                }
            },
            "styleProps": {
                "boxShadow": {
                    "selectors": {
                        "desktop": {
                            "value": ".difl_imagehotspot .difl_imagehotspotitem{{selector}}",
                            "hover": ".difl_imagehotspot .difl_imagehotspotitem{{selector}}:hover"
                        }
                    }
                }
            }
        },
        "spot_item_font": {
            "settings": {
                "decoration": {
                    "font": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "spot_item_design",
                            "attrName": "spot_item_font.decoration.font",
                            "label": null,
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/font",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": "",
                                    "fields": {
                                        "headingLevel": {
                                            "render": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "styleProps": {
                "font": {
                    "selectors": {
                        "desktop": {
                            "value": ".difl_imagehotspot .difl_imagehotspotitem{{selector}} .difl_marker_wrapper",
                            "hover": ".difl_imagehotspot .difl_imagehotspotitem{{selector}}:hover .difl_marker_wrapper"
                        }
                    },
                    "important": {
                        "desktop": {
                            "value": true
                        }
                    }
                }
            }
        },
        "spot_image_border": {
            "settings": {
                "decoration": {
                    "border": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "spot_icon_image",
                            "attrName": "spot_image_border.decoration.border",
                            "label": "Spot Image",
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/border",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": "Spot Image"
                                }
                            }
                        }
                    }
                }
            },
            "styleProps": {
                "border": {
                    "selectors": {
                        "desktop": {
                            "value": ".difl_imagehotspot {{selector}} .difl_image_marker img , .difl_imagehotspot {{selector}} .et-pb-icon.df-image-hotspot-icon",
                            "hover": ".difl_imagehotspot {{selector}}:hover .difl_image_marker img , .difl_imagehotspot {{selector}}:hover .et-pb-icon.df-image-hotspot-icon"
                        }
                    }
                }
            }
        },
        "admin_label": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "admin_label",
                        "render": true,
                        "attrName": "admin_label.innerContent",
                        "label": "Admin Label",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/text"
                        }
                    }
                }
            }
        },
        "spot_type": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "spot",
                        "render": true,
                        "attrName": "spot_type.innerContent",
                        "label": "Spot Type",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/select",
                            "props": {
                                "options": {
                                    "icon": {
                                        "label": "Icon"
                                    },
                                    "text": {
                                        "label": "Text"
                                    },
                                    "empty": {
                                        "label": "Blank"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "spot_text": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "spot",
                        "render": true,
                        "attrName": "spot_text.innerContent",
                        "label": "Spot Text",
                        "description": "Spot Text. We can use Html tag also",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/codemirror"
                        }
                    }
                }
            },
            "show_if": {
                "spot_type": [
                    "text",
                    "both_icon_and_text"
                ]
            }
        },
        "use_image_as_icon": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
