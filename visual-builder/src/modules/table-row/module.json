        "row_text": {
            "settings": {
                "decoration": {
                    "font": {
                        "groupType": "group-item",
                        "item": {
                            "groupSlug": "design_row",
                            "attrName": "row_text.decoration.font",
                            "label": "Row",
                            "render": true,
                            "component": {
                                "type": "group",
                                "name": "divi/font",
                                "props": {
                                    "grouped": false,
                                    "fieldLabel": "Row",
                                    "fields": {
                                        "headingLevel": {
                                            "render": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "styleProps": {
                "font": {
                    "selectors": {
                        "desktop": {
                            "value": ".entry-content thead {{selector}} th, \n                                    table.df_dt_content tbody tr{{selector}} td.df_dt_table_body_column_cell",
                            "hover": ".entry-content thead {{selector}}:hover th,\n                                    table.df_dt_content tbody tr{{selector}}:hover td.df_dt_table_body_column_cell"
                        }
