                    "border": {},
                    "boxShadow": {},
                    "filters": {}
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Advanced Pricing Table"
                        }
                    }
                }
            },
            "styleProps": {
                "boxShadow": {
                    "selectors": {
                        "desktop": {
