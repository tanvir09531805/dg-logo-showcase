{
    "name": "difl/imagegalleryitem",
    "d4Shortcode": "difl_imagegalleryitem",
    "title": "Advanced Gallery Item",
    "titles": "Advanced Gallery Items",
    "category": "child-module",
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "gallery": {
                "panel": "content",
                "groupName": "gallery",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Gallery"
                    }
                }
            },
            "contentLink": {
                "panel": "content",
                "groupName": "link",
                "priority": 100,
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Link",
                        "preset": "content"
                    }
                }
            }
        }
    },
    "customCssFields": {
        "title": {
            "label": "Label 1"
        },
        "content": {
            "label": "Label 2"
        }
    },
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "settings": {
                "meta": {
                    "adminLabel": {
                        "component": {
                            "type": "group",
                            "name": "divi/admin-label"
                        }
                    }
                },
                "advanced": {
                    "link": {
                        "item": {
                            "groupSlug": "contentLink",
                            "component": {
                                "props": {
                                    "fieldLabel": ""
                                }
                            }
                        }
                    }
                }
            },
            "default": {
                "meta": {
                    "adminLabel": {
                        "desktop": {
                            "value": "Advanced Gallery Item"
                        }
                    }
                }
            }
        },
        "gallery_title": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "gallery",
                        "render": true,
                        "attrName": "gallery_title.innerContent",
                        "label": "Title",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/text"
                        }
                    }
                }
            }
        },
        "gallery_ids": {
            "type": "object",
            "selector": "",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "gallery",
                        "render": true,
                        "attrName": "gallery_ids.innerContent",
                        "label": "Gallery Images",
                        "description": "Choose images that you would like to appear in the image gallery.",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/upload-gallery"
                        }
                    }
                }
            }
        },
        "admin_label": {
            "type": "object",
            "selector": "",
            "inlineEditor": true,
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupSlug": "admin_label",
                        "render": true,
                        "attrName": "admin_label.innerContent",
                        "label": "Admin Label",
                        "features": {
                            "sticky": false,
                            "hover": false,
                            "responsive": false
                        },
                        "component": {
                            "type": "field",
                            "name": "divi/text"
                        }
                    }
                }
            }
        }
    }
}