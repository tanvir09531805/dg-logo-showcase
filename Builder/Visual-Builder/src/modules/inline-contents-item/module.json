{
  "name": "difl/inline-contents-item",
  "d4Shortcode": "difl_inline_contents_item",
  "title": "Inline Content",
  "titles": "Inline Contents",
  "moduleClassName": "difl_inline_contents_item",
  "moduleOrderClassName": "difl_inline_contents_item",
  "category": "child-module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Inline Content"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "link": {
            "priority": 70,
            "component": {
              "type": "group",
              "name": "divi/link"
            }
          }
        },
        "decoration": {
          "background": {
            "priority": 80,
            "component": {
              "type": "group",
              "name": "divi/background"
            }
          },
          "sizing": {
            "priority": 80,
            "component": {
              "type": "group",
              "name": "divi/sizing",
              "props": {
                "fields": {
                  "maxWidth": {
                    "render": false
                  },
                  "alignment": {
                    "render": false
                  },
                  "maxHeight": {
                    "render": false
                  },
                  "minHeight": {
                    "render": false
                  },
                  "height": {
                    "component": {
                      "props": {
                        "defaultUnit": "px",
                        "allowedUnits": [ "px" ],
                        "step": 1,
                        "min": 1,
                        "max": 500
                      }
                    }
                  },
                  "width": {
                    "component": {
                      "props": {
                        "defaultUnit": "px",
                        "allowedUnits": [ "px" ],
                        "step": 1,
                        "min": 1,
                        "max": 500
                      }
                    }
                  }
                },
                "defaultGroupAttr": {
                  "desktop": {
                    "value": {
                      "width": "80px",
                      "height": "80px"
                    }
                  }
                }
              }
            }
          },
          "spacing": {
            "priority": 90,
            "component": {
              "type": "group",
              "name": "divi/spacing"
            }
          },
          "border": {
            "priority": 96,
            "component": {
              "type": "group",
              "name": "divi/border",
              "props": {
                "groupLabel": "Border"
              }
            }
          },
          "boxShadow": {
            "priority": 96,
            "component": {
              "type": "group",
              "name": "divi/box-shadow",
              "props": {
                "groupLabel": "Box Shadow"
              }
            }
          },
          "transition": {
            "priority": 60,
            "component": {
              "type": "group",
              "name": "divi/transition"
            }
          },
          "filters": {},
          "transform": {}
        },
        "meta": {
          "adminLabel": {
            "priority": 99,
            "component": {
              "type": "group",
              "name": "divi/admin-label"
            }
          }
        }
      }
    },
    "content_main": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "content_type": {
              "groupSlug": "content_main",
              "attrName": "content_main.innerContent.content_type",
              "label": "Content Type",
              "description": "",
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content"
              },
              "render": true,
              "priority": 10,
              "component": {
                "type": "field",
                "name": "divi/select",
                "props": {
                  "options": {
                    "Text": {
                      "label": "Text"
                    },
                    "Icon": {
                      "label": "Icon"
                    },
                    "Image": {
                      "label": "Image"
                    },
                    "Line_Break": {
                      "label": "Line Break"
                    }
                  }
                }
              },
              "defaultAttr": {
                "desktop": {
                  "value": "Text"
                }
              }
            },
            "content_text": {
              "groupSlug": "content_main",
              "attrName": "content_main.innerContent.content_text",
              "label": "Content Text",
              "description": "Write your desire text.",
              "priority": 20,
              "render": true,
              "features": {
                "hover": false,
                "sticky": false,
                "responsive": false,
                "preset": "content",
                "dynamicContent": {
                  "type": "text"
                }
              },
              "component": {
                "type": "field",
                "name": "divi/text",
                "props": {
                  "showPlaceholderOnEmpty": true
                }
              }
            },
            "content_icon": {
              "groupSlug": "content_main",
              "attrName": "content_main.innerContent.content_icon",
              "label": "Icon",
              "description": "",
              "render": true,
              "priority": 20,
              "features": {
                "hover": true,
                "sticky": false,
                "responsive": true,
                "preset": "content",
                "dynamicContent": {
                  "type": "text"
                }
              },
              "component": {
                "name": "divi/icon-picker",
                "type": "field"
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "type": "divi",
                    "unicode": "&#xe08a;",
                    "weight": "400"
                  }
                }
              }
            },
            "content_image": {
              "groupSlug": "content_main",
              "attrName": "content_main.innerContent.content_image",
              "priority": 10,
              "render": true,
              "subName": "src",
              "label": "Image",
              "description": "",
              "features": {
                "dynamicContent": {
                  "type": "image"
                },
                "sticky": false,
                "hover": true,
                "responsive": true,
                "preset": [
                  "html"
                ]
              },
              "component": {
                "name": "divi/upload",
                "type": "field",
                "props": {
                  "syncImageData": {
                    "src": true,
                    "id": true,
                    "alt": true,
                    "titleText": false
                  },
                  "dataType": "image"
                }
              }
            }
          }
        }
      }
    },
    "content_text": {
      "type": "object",
      "selector": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item.difl_inline_content_text",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "content_text",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false
                }
              },
              "defaultAttr": {
                "desktop": {
                  "value": {
                    "size": "13px"
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item.difl_inline_content_text",
          "selectors": {
            "desktop": {
              "value": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item.difl_inline_content_text",
              "hover": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item.difl_inline_content_text{{:hover}}"
            }
          }
        }
      }
    },
    "content_icon": {
      "type": "object",
      "selector": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item.difl_inline_content_icon",
      "settings": {
        "decoration": {
          "icon_data": {
            "groupType": "group-items",
            "items": {
              "icon_color": {
                "groupSlug": "content_icon",
                "attrName": "content_icon.decoration.font.font",
                "subName": "color",
                "label": "Color",
                "description": "Here you can define a custom color for your icon.",
                "priority": 20,
                "render": true,
                "features": {
                  "hover": false,
                  "sticky": false,
                  "responsive": false,
                  "preset": "content"
                },
                "component": {
                  "type": "field",
                  "name": "divi/color-picker"
                },
                "defaultAttr": {
                  "desktop": {
                    "value": {
                      "color": "#2ea3f2"
                    }
                  }
                }
              },
              "icon_size": {
                "groupSlug": "content_icon",
                "attrName": "content_icon.decoration.font.font",
                "subName": "size",
                "label": "Size",
                "description": "Here you can choose Icon Size.",
                "priority": 20,
                "render": true,
                "features": {
                  "hover": false,
                  "sticky": false,
                  "responsive": true,
                  "preset": "content"
                },
                "component": {
                  "type": "field",
                  "name": "divi/range",
                  "props": {
                    "min": 1,
                    "max": 200,
                    "step": 1,
                    "defaultUnit": "px",
                    "allowedUnits": [ "px" ]
                  }
                },
                "defaultAttr": {
                  "desktop": {
                    "value": {
                      "size": "24px"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item.difl_inline_content_icon",
          "selectors": {
            "desktop": {
              "value": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item.difl_inline_content_icon",
              "hover": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item.difl_inline_content_icon{{:hover}}"
            }
          }
        }
      }
    },
    "content_media": {
      "type": "object",
      "selector": "#difl-inline-contents-container {{selector}}.difl_inline_contents_item",
      "settings": {
        "decoration": {
          "background": {
            "groupType": "group-items",
            "items": {
              "media_size": {
                "groupSlug": "content_media",
                "attrName": "content_media.decoration.media_size",
                "label": "Size",
                "description": "Here you can choose Image Size.",
                "priority": 20,
                "render": true,
                "features": {
                  "hover": false,
                  "sticky": false,
                  "responsive": true,
                  "preset": "content"
                },
                "component": {
                  "type": "field",
                  "name": "divi/range",
                  "props": {
                    "min": 1,
                    "max": 200,
                    "step": 1,
                    "defaultUnit": "px",
                    "allowedUnits": [ "px" ]
                  }
                },
                "defaultAttr": {
                  "desktop": {
                    "value": "40px"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "content_main": {
        "panel": "content",
        "priority": 20,
        "groupName": "content_main",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "content_text": {
        "panel": "design",
        "priority": 20,
        "groupName": "content_text",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Text"
          }
        }
      },
      "content_icon": {
        "panel": "design",
        "priority": 20,
        "groupName": "content_icon",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Icon"
          }
        }
      },
      "content_media": {
        "panel": "design",
        "priority": 20,
        "groupName": "content_media",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "visible": true,
            "groupLabel": "Image"
          }
        }
      }
    }
  },
  "customCssFields": {
  },
  "mousetrap": {
    "inner": {
      "edited": true
    }
  }
}