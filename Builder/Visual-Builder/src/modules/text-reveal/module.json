{
   "name": "difl/text-reveal",
   "d4Shortcode": "difl_text_reveal",
   "moduleIcon": "difl/scroll-text-reveal",
   "title": "Scrolling Text Reveal",
   "titles": "Scrolling Text Reveals",
   "category": "module",
   "folder": "diviflash-modules",
   "attributes": {
      "module": {
         "type": "object",
         "selector": "{{selector}}",
         "default": {
            "meta": {
               "adminLabel": {
                  "desktop": {
                     "value": "Scroll Text Reveal"
                  }
               }
            },
            "advanced": {
               "text": {
                  "desktop": {
                     "value": {
                        "color": "light"
                     }
                  }
               }
            }
         },
         "styleProps": {
            "sizing": {
               "propertySelectors": {
                  "desktop": {
                     "value": {
                        "margin-left": "{{selector}}.et_pb_module",
                        "margin-right": "{{selector}}.et_pb_module"
                     }
                  }
               },
               "important": {
                  "desktop": {
                     "value": {
                        "margin-left": true,
                        "margin-right": true
                     }
                  }
               }
            }
         }
      },
      "settings__content": {
         "type": "object",
         "selector": "{{selector}} .df_text_reveal_main_container",
        "default": {
          "innerContent": {
            "desktop": {
              "value": "Add Content"
            }
          }
        },
         "decoration": {
            "font": {
               "important": true
            }
         }
      },
      "settings__trigger_type": {
         "type": "object",
         "default": {
            "innerContent": {
               "desktop": {
                  "value": "with-scroll"
               }
            }
         }
      },
      "settings__split_content": {
         "type": "object",
         "default": {
            "innerContent": {
               "desktop": {
                  "value": "df_text_reveal_letter_by_letter"
               }
            }
         }
      },
      "settings__reveal_by": {
         "type": "object",
         "default": {
            "innerContent": {
               "desktop": {
                  "value": "df_text_reveal_by_opacity_animationr"
               }
            }
         }
      },
      "settings__reveal_color": {
         "type": "object",
         "default": {
            "decoration": {
               "desktop": {
                  "value": "#0038f0"
               }
            }
         }
      },
      "settings__reveal_duration": {
         "type": "object",
         "default": {
            "innerContent": {
               "desktop": {
                  "value": "1000"
               }
            }
         }
      },
      "settings__reveal_delay": {
         "type": "object",
         "default": {
            "innerContent": {
               "desktop": {
                  "value": "0"
               }
            }
         }
      },
      "settings__reveal_initial_opacity": {
         "type": "object",
         "default": {
            "innerContent": {
               "desktop": {
                  "value": "0.2"
               }
            }
         }
      },
      "settings__reveal_viewport_offset_value_top": {
         "type": "object",
         "default": {
            "innerContent": {
               "desktop": {
                  "value": "0"
               }
            }
         }
      },
      "settings__reveal_viewport_offset_value_bottom": {
         "type": "object",
         "default": {
            "innerContent": {
               "desktop": {
                  "value": "0"
               }
            }
         }
      },
      "content": {
         "type": "object",
         "selector": "{{selector}} .dtmc_static_module_content",
         "attributes": {
            "class": "dtmc_static_module_content"
         },
         "tagName": "div",
         "childrenSanitizer": "et_core_esc_previously",
         "allowHtml": true,
         "styleProps": {
            "bodyFont": {
               "important": {
                  "body": {
                     "font": {
                        "desktop": {
                           "value": {
                              "color": true
                           }
                        }
                     }
                  }
               }
            }
         }
      }
   },
   "customCssFields": {
      "title": {
         "subName": "title",
         "selectorSuffix": " .dtmc_static_module_title"
      },
      "content": {
         "subName": "content",
         "selectorSuffix": " .dtmc_static_module_content"
      }
   },
   "settings": {
      "groups": {
         "toggle_key__content_two": {
            "groupName": "Text 2"
         }
      }
   }
}
