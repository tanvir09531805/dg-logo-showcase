{
  "name": "difl/vertical-menu",
  "d4Shortcode": "difl_vertical_menu",
  "moduleIcon": "difl/vertical-menu",
  "title": "Vertical Menu",
  "titles": "Vertical Menus",
  "category": "module",
  "folder": "diviflash-modules",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Vertical Menu"
            }
          }
        },
        "advanced": {
          "text": {
            "desktop": {
              "value": {
                "color": "light"
              }
            }
          }
        }
      },
      "styleProps": {
        "sizing": {
          "propertySelectors": {
            "desktop": {
              "value": {
                "margin-left": "{{selector}}.et_pb_module",
                "margin-right": "{{selector}}.et_pb_module"
              }
            }
          },
          "important": {
            "desktop": {
              "value": {
                "margin-left": true,
                "margin-right": true
              }
            }
          }
        }
      }
    },
    "settings__select_menu_slug": {
      "type": "object",
      "selector": "{{selector}} .df-vertical-menu-item-title",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "none"
          }
        }
      }
    },
    "settings__builder_visiblity": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "settings__submenu_reveal_type": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "df-vertical-sub-menu-reveal-flyout"
          }
        }
      }
    },
    "settings__submenu_reveal_dir": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "df-vertical-sub-menu-reveal-right"
          }
        }
      }
    },
    "settings__clicked_menu_element_style": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "settings__badge_visiblity": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      }
    },
    "settings__tooltip_visiblity": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "on"
          }
        }
      }
    },
    "settings__menu_item_hover_animation": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "settings__select_animation_type": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "item-hover-1"
          }
        }
      }
    },
    "settings__select_animation_color": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "decoration": {
          "desktop": {
            "value": "#0038f0"
          }
        }
      }
    },
    "settings__animation__line_weight": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "2px"
          }
        }
      }
    },
    "settings__use_hamburger_for_mobile": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "settings__hamburger_menu_reveal_type": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "df_hamburger_reveal_on_click"
          }
        }
      }
    },
    "settings__hamburger_text": {
      "type": "object",
      "selector": "{{selector}}"
    },
    "settings__hamburger_icon_preset": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "icon1"
          }
        }
      }
    },
    "style_settings__menu__item_gap": {
      "type": "object",
      "default": {
        "decoration": {
          "desktop": {
            "value": "0px"
          }
        }
      }
    },
    "style_settings__menu__item": {
      "type": "object",
      "selector": "{{selector}}  li > a",
      "default": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "16px",
                  "lineHeight": "1.4em"
                }
              }
            }
          },
          "spacing": {
            "desktop": {
              "value": {
                "padding": {
                  "top": "10px",
                  "bottom": "10px",
                  "left": "10px",
                  "right": "10px"
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "important": true
        },
        "spacing": {
          "important": true
        }
      }
    },
    "style_settings__menu__item_icon": {
      "type": "object",
      "selector": "{{selector}}  li > .df_vertical_menu_item_elements_wrapper .df-vertical-menu-icon,{{selector}} li > .df_vertical_menu_item_elements_wrapper > img",
      "styleProps": {
        "font": {
          "important": true
        }
      }
    },
    "style_settings__alignment": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "df-vertical-menu-alignment-justified"
          }
        }
      }
    },
    "style_settings__sub_menu__item_gap": {
      "type": "object",
      "default": {
        "decoration": {
          "desktop": {
            "value": "0px"
          }
        }
      }
    },
    "style_settings__sub_menu__tree_view": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "off"
          }
        }
      }
    },
    "style_settings__sub_menu__tree_view_spacing": {
      "type": "object",
      "default": {
        "decoration": {
          "desktop": {
            "value": "10px"
          }
        }
      }
    },
    "style_settings__sub_menu__item": {
      "type": "object",
      "selector": "{{selector}}  .df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu):not(.df-vertical-custom-submenu) > li  .df_vertical_menu_item_elements_wrapper",
      "default": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "16px",
                  "lineHeight": "1.4em"
                }
              }
            }
          },
          "spacing": {
            "desktop": {
              "value": {
                "padding": {
                  "top": "10px",
                  "bottom": "10px",
                  "left": "10px",
                  "right": "10px"
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "spacing": {
          "important": true
        }
      }
    },
    "style_settings__sub_menu__item_icon": {
      "type": "object",
      "selector": "{{selector}}  .df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu) > li > .df_vertical_menu_item_elements_wrapper .df-vertical-menu-icon,{{selector}} .df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu) > li > .df_vertical_menu_item_elements_wrapper> img",
      "default": {
        "decoration": {
          "spacing": {
            "desktop": {
              "value": {
                "margin": {
                  "top": "10px",
                  "bottom": "10px",
                  "left": "10px",
                  "right": "10px"
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "important": true
        }
      }
    },
    "style_settings__mega_menu__item_gap": {
      "type": "object",
      "default": {
        "decoration": {
          "desktop": {
            "value": "0px"
          }
        }
      }
    },
    "style_settings__mega_menu__item": {
      "type": "object",
      "selector": "{{selector}}  .df-vertical-sub-menu.df-vertical-col-added li .df_vertical_menu_item_elements_wrapper",
      "default": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "16px",
                  "lineHeight": "1.4em"
                }
              }
            }
          },
          "spacing": {
            "desktop": {
              "value": {
                "padding": {
                  "top": "10px",
                  "bottom": "10px",
                  "left": "10px",
                  "right": "10px"
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "spacing": {
          "important": true
        }
      }
    },
    "style_settings__mega_menu__item_icon": {
      "type": "object",
      "selector": "{{selector}}  .df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu) > li > .df_vertical_menu_item_elements_wrapper .df-vertical-menu-icon,{{selector}} .df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu) > li > .df_vertical_menu_item_elements_wrapper> img",
      "default": {
        "decoration": {
          "spacing": {
            "desktop": {
              "value": {
                "margin": {
                  "top": "10px",
                  "bottom": "10px",
                  "left": "10px",
                  "right": "10px"
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "important": true
        }
      }
    },
    "style_settings__sub_menu__wrapper": {
      "type": "object",
      "selector": "{{selector}}  .df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu):not(.df-vertical-mega-menu-item):not(.df-vertical-custom-submenu)"
    },
    "style_settings__mega_menu__columns": {
      "type": "object",
      "default": {
        "decoration": {
          "desktop": {
            "value": "0px"
          }
        }
      }
    },
    "style_settings__mega_menu__wrapper": {
      "type": "object",
      "selector": "{{selector}}  .df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu):not(.df-vertical-mega-menu-item):not(.df-vertical-custom-submenu)"
    },
    "style_settings__mega_menu__parent": {
      "type": "object",
      "selector": "{{selector}}  ul.df-vertical-sub-menu.df-vertical-col-added > div > li > .df_vertical_menu_item_elements_wrapper"
    },
    "style_settings__menu__active__state_item": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap  ul.df-vertical-menu-nav  li[class*='current'] .df_vertical_menu_item_elements_wrapper"
    },
    "style_settings__menu__active__state_item_icon": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap  ul.df-vertical-menu-nav li[class*='current'] .df_vertical_menu_item_elements_wrapper>.df-vertical-menu-icon"
    },
    "style_settings__sub_menu__active__state_item": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap  ul.df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu) > li[class*='current'] > .df_vertical_menu_item_elements_wrapper"
    },
    "style_settings__sub_menu__active__state_item_icon": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap  ul.df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-col-added>ul):not(.df-vertical-inside-mega-menu)>li[class*='current']>.df_vertical_menu_item_elements_wrapper>.df-vertical-menu-icon ",
      "styleProps": {
        "font": {
          "important": true
        },
        "background": {
          "important": true
        }
      }
    },
    "style_settings__mega_menu__active__state_item": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap  ul.df-vertical-sub-menu.df-vertical-col-added  li[class*='current'] > .df_vertical_menu_item_elements_wrapper",
      "styleProps": {
        "font": {
          "important": true
        },
        "background": {
          "important": true
        }
      }
    },
    "style_settings__mega_menu__active__state_item_icon": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap  ul.df-vertical-sub-menu.df-vertical-col-added  li[class*='current'] > .df_vertical_menu_item_elements_wrapper .df-vertical-menu-icon",
      "styleProps": {
        "font": {
          "important": true
        },
        "background": {
          "important": true
        }
      }
    },
    "style_settings__menu__badge": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap li>.df_vertical_menu_item_elements_wrapper .df-vertical-nav-item-badge",
      "styleProps": {
        "font": {
          "important": true
        },
        "background": {
          "important": true
        }
      }
    },
    "style_settings__sub_menu__badge": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap .df-vertical-sub-menu:not(.df-vertical-col-added):not(.df-vertical-inside-mega-menu) li>.df_vertical_menu_item_elements_wrapper .df-vertical-nav-item-badge",
      "styleProps": {
        "font": {
          "important": true
        },
        "background": {
          "important": true
        }
      }
    },
    "style_settings__menu__tooltip": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap li>.df_vertical_menu_item_elements_wrapper .df-vertical-nav-item-tooltip",
      "styleProps": {
        "font": {
          "important": true
        },
        "background": {
          "important": true
        }
      }
    },
    "style_settings__sub_menu__tooltip": {
      "type": "object",
      "selector": "{{selector}}.df_vertical_menu_main_container .df-vertical-menu-nav-wrap .df-vertical-sub-menu li>.df_vertical_menu_item_elements_wrapper .df-vertical-nav-item-tooltip",
      "styleProps": {
        "font": {
          "important": true
        },
        "background": {
          "important": true
        }
      }
    }
  },
  "customCssFields": {
    "main_menu": {
      "subName": "Main Menu ",
      "selectorSuffix": " ul"
    }
  }
}