              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": false,
                  "fieldLabel": "Separator",
                  "fields": {
                    "headingLevel": {
                      "render": false
                    }
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selectors": {
            "desktop": {
              "value": "{{selector}} .difl-divider-icon .difl-divider-icon-text"
            }
          },
          "important": {
            "desktop": {
              "value": true
            }
          }
        }
      }
    },
