        "decoration": {
          "animation": {},
          "background": {},
          "conditions": {},
          "disabledOn": {},
          "filters": {},
          "border": {},
          "boxShadow": {},
          "overflow": {},
          "position": {},
          "sizing": {},
          "sticky": {},
          "transform": {},
          "transition": {},
          "zIndex": {}
        }
      },
      "default": {
        "meta": {
